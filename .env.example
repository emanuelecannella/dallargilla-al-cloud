# Copia questo file in ".env" e cambia i valori prima di avviare il progetto.
# Il file .env non va mai su Git: contiene password e chiavi segrete.

# Database PostgreSQL
POSTGRES_USER=terracotta
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=terracotta_viva

# Indirizzo usato dal back-end per collegarsi al database (il nome host "db" è il container)
DATABASE_URL=postgresql+psycopg2://terracotta:cambiami@db:5432/terracotta_viva

# Chiave usata per firmare i token di accesso: usa una stringa lunga e casuale
JWT_SECRET=cambia-questa-chiave-con-una-stringa-lunga-e-casuale
JWT_SCADENZA_MINUTI=60

# Origini autorizzate a chiamare le API (il front-end React)
CORS_ORIGINI=["http://localhost:5173"]
